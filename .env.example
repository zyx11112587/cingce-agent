# Multiple input roots; use ; on Windows and : on Linux/macOS.
EXAM_RAG_INPUT_DIRS=./xingcezhenti;./data/raw;./data/politics;./data/shenlun
EXAM_RAG_DB=./data/index/exam.sqlite3
EXAM_RAG_VECTOR_DIR=./data/index/vectors
EXAM_RAG_ASSETS=./data/assets

# Built-in HTTP server
EXAM_RAG_HOST=127.0.0.1
EXAM_RAG_PORT=8000
EXAM_RAG_TOP_K=5

# OpenAI-compatible API. Ollama and vLLM can use the same variables.
# EXAM_RAG_LLM_BASE_URL=http://127.0.0.1:11434/v1
# EXAM_RAG_LLM_API_KEY=
# EXAM_RAG_LLM_MODEL=qwen2.5:7b
# EXAM_RAG_LLM_TIMEOUT=120

# OpenAI-compatible embedding API, or sentence_transformers locally.
EXAM_RAG_EMBEDDING_PROVIDER=auto
# EXAM_RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EXAM_RAG_EMBEDDING_API_KEY=
# EXAM_RAG_EMBEDDING_MODEL=bge-m3
# EXAM_RAG_EMBEDDING_BATCH_SIZE=32

# Hybrid retrieval weights (RRF).
EXAM_RAG_BM25_WEIGHT=0.5
EXAM_RAG_VECTOR_WEIGHT=0.5
EXAM_RAG_RRF_K=60
